# NUNCA subas este archivo con tu clave real a GitHub (.env ya esta en .gitignore).
# Clave privada de la wallet de Solana del bot, en base58 (la que exporta Phantom/Solflare).
# Usa una wallet NUEVA y dedicada al bot, con solo el dinero que estas dispuesto a perder.
SOLANA_PRIVATE_KEY=

# RPC de Solana. El publico funciona pero es lento y limitado; para operar en serio usa
# uno privado (Helius, QuickNode, Triton...). Ej: https://mainnet.helius-rpc.com/?api-key=XXXX
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Opcional: alertas por Telegram (crea un bot con @BotFather y obtén tu chat id con @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
